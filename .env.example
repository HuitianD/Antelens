# Copy to ignored .env.local. pnpm dev defaults to explicitly labeled, loopback-only demo.
APP_MODE=demo
WEB_ORIGIN=http://127.0.0.1:3000
API_ORIGIN=http://127.0.0.1:4000
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:4000
ALLOWED_EXTENSION_ORIGINS=
# Public browser settings (never use a service-role key here).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Trusted backend only; direct or session-pool PostgreSQL connection for pg-boss.
SUPABASE_URL=
# Preferred backend secret key from Settings > API Keys. Never expose to the browser.
SUPABASE_SECRET_KEY=
# Optional legacy service_role JWT; use only when a new secret key is unavailable.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
SUPABASE_STORAGE_BUCKET=beforeyou-evidence
# Separate read-only Gmail consent. Register this exact redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4000/v1/connections/gmail/callback
# 32-byte base64 encryption key, generated locally; never paste into chat.
CREDENTIAL_ENCRYPTION_KEY=
# Factory runtime with explicit Anthropic BYOK model; verify available model before use.
FACTORY_API_KEY=
ANTHROPIC_API_KEY=
# Required only for user-scoped Anthropic keys (sk-ant-usr-...); workspace-scoped keys leave this empty.
ANTHROPIC_WORKSPACE_ID=
CLAUDE_MODEL_ID=
DAYTONA_API_KEY=
DAYTONA_SNAPSHOT=
# daytona (default): isolated sandbox browser, required for any real user destination.
# local_controlled: labeled fallback that opens only CONTROLLED_FIXTURE_ORIGIN pages on the worker host; runs are marked as not using Daytona.
BROWSER_RUNTIME=daytona
GMAIL_POLL_INTERVAL_SECONDS=15
# true imports only Gmail subjects containing [BY-TEST], including replies. Empty keeps the normal sync window.
GMAIL_TEST_MODE=
# Only owned synthetic test mailboxes; matched server-side, never accepted from client.
SYNTHETIC_GMAIL_ACCOUNT_IDS=
MAX_INVESTIGATION_STEPS=12
INVESTIGATION_TIMEOUT_MS=120000
MODEL_MAX_OUTPUT_TOKENS=4096
# Exact supported HTTPS hostnames for real investigations, comma-separated; no wildcard.
INVESTIGATION_ALLOWED_DOMAINS=
# Owned HTTPS fixture deployment origin used only by pnpm eval --live.
CONTROLLED_FIXTURE_ORIGIN=
# Optional packaged Droid override. Leave empty to use the pinned droid dependency.
DROID_EXEC_PATH=
# Optional private temporary parent directory for per-run Droid settings; not web-served.
AGENT_RUNTIME_DIRECTORY=
# Public extension build allowlist. Build in apps/extension with these values available.
# WXT reads its own .env.local; never copy root backend secrets into extension config.
VITE_API_ORIGIN=http://127.0.0.1:4000
VITE_WEB_ORIGIN=http://127.0.0.1:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPPORTED_ORIGINS=http://127.0.0.1:4080
# Controlled explicit extension capture. SDK file transfer does not require sandbox egress.
CAPTURE_ALLOWED_ORIGIN=http://127.0.0.1:4080
# The controlled demo pages (/fixtures/SC-01, SC-10..SC-13) are always allowed; this adds one further exact path.
CAPTURE_ALLOWED_PATH=/fixtures/SC-01
VITE_CAPTURE_ORIGIN=http://127.0.0.1:4080
# Same rule in the extension: the controlled demo pages are built in; this adds one further exact path.
VITE_CAPTURE_PATH=/fixtures/SC-01
VITE_GOOGLE_SIGN_IN_ENABLED=false
